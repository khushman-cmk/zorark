# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/.artifacts/
/e2e/.auth/

# Persistent browser profiles used by the provider connect helper
/.playwright-profiles/

# Safe routing: downloaded/generated map data and the routing engine
/data/osm/
/data/safety/
/public/safety/
/public/maplibre/
/graphhopper/*.jar
/graphhopper/graph-cache/
/graphhopper/logs/
/graphhopper/server.log
/graphhopper/models/safety.json
/scripts/safety/.venv/
__pycache__/
